# Copy this file to .env and fill in your values. .env is git-ignored; never commit a key.
# With no key set, the offline mock LLM is used.

# Qwen3-8B on the course inference API (Track B). Use the URL and certificate for YOUR group:
#   groups 001-015: https://103.42.50.41:1031/v1  vm07-ca.crt
#   groups 016-030: https://103.42.50.41:1032/v1  vm06-ca.crt
#   groups 031-045: https://103.42.50.41:1033/v1  vm05-ca.crt
#   groups 046-065: https://103.42.50.41:1034/v1  vm04-ca.crt
QWEN_API_BASE=https://103.42.50.41:1033/v1
QWEN_API_KEY=<your-group-key>
QWEN_CA_CERT=vm05-ca.crt
QWEN_MODEL=Qwen/Qwen3-8B

# Optional alternative: Azure OpenAI (used only if QWEN_API_KEY is not set)
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=<your-key>
# AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
# AZURE_OPENAI_API_VERSION=2024-08-01-preview
